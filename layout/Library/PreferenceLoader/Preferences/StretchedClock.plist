<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>entry</key>
    <dict>
        <key>cell</key>
        <string>PSLinkCell</string>
        <key>label</key>
        <string>StretchedClock</string>
    </dict>
    <key>items</key>
    <array>
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Основное</string>
            <key>footerText</key>
            <string>Вытянутые часы экрана блокировки в стиле iOS 18. Дата аккуратно размещена над часами.</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>default</key>
            <true/>
            <key>defaults</key>
            <string>com.harsed.stretchedclock</string>
            <key>key</key>
            <string>enabled</string>
            <key>label</key>
            <string>Включено</string>
            <key>PostNotification</key>
            <string>com.harsed.stretchedclock/prefsChanged</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Ширина цифр (Scale X)</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSliderCell</string>
            <key>default</key>
            <real>0.65</real>
            <key>defaults</key>
            <string>com.harsed.stretchedclock</string>
            <key>key</key>
            <string>scaleX</string>
            <key>min</key>
            <real>0.30</real>
            <key>max</key>
            <real>1.50</real>
            <key>showValue</key>
            <true/>
            <key>PostNotification</key>
            <string>com.harsed.stretchedclock/prefsChanged</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Высота цифр (Scale Y)</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSliderCell</string>
            <key>default</key>
            <real>2.00</real>
            <key>defaults</key>
            <string>com.harsed.stretchedclock</string>
            <key>key</key>
            <string>scaleY</string>
            <key>min</key>
            <real>1.00</real>
            <key>max</key>
            <real>4.00</real>
            <key>showValue</key>
            <true/>
            <key>PostNotification</key>
            <string>com.harsed.stretchedclock/prefsChanged</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Применение изменений</string>
            <key>footerText</key>
            <string>Нажмите кнопку ниже, чтобы перезапустить SpringBoard и применить новые параметры.</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSButtonCell</string>
            <key>label</key>
            <string>⚡️ Сделать Респринг</string>
            <key>action</key>
            <string>respringAction</string>
        </dict>
    </array>
</dict>
</plist>
